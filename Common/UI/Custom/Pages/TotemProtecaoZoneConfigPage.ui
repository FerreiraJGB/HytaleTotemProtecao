$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 600, Height: 400);

  #Title {
    Group {
      $C.@Title {
        @Text = "Configuracion de la Zona";
      }
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Right: 15, Bottom: 5);

    Group {
      LayoutMode: Left;

      Label {
        FlexWeight: 1;
        Text: %server.customUI.itemRepairPage.item;
        Style: (RenderBold: true);
      }

      Label {
        Text: %server.customUI.itemRepairPage.durability;
        Style: (RenderBold: true);
      }
    }

    Group #ElementList {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
    }

    Group #Footer {
      Anchor: (Height: 100);
      LayoutMode: Top;
      Padding: (Horizontal: -2);

      Group #FooterDivider {
        Anchor: (Height: 2);
        Background: #19252F;
      }

      Group #FooterContent {
        FlexWeight: 1;
        LayoutMode: Top;
        Padding: (Top: 4, Bottom: 2);

        Label #FooterLine1 {
          Style: (
            FontSize: 12,
            TextColor: #b4c8c9,
            HorizontalAlignment: Center,
            VerticalAlignment: Center,
          );
          Text: "Coloca el objeto en la mano y usa el totem para recargarlo. La carga se pierde si se rompe.";
        }

        Group #FooterLine2 {
          LayoutMode: Center;
          Padding: (Top: 2);

          ItemIcon #FooterItem1Icon {
            Anchor: (Width: 16, Height: 16);
            ItemId: "Ingredient_Voidheart";
          }

          Label #FooterItem1Text {
            Padding: (Left: 6);
            Style: (FontSize: 12, TextColor: #b4c8c9);
            Text: "Corazon del Vacio = 12h";
          }
        }

        Group #FooterLine3 {
          LayoutMode: Center;
          Padding: (Top: 2);

          ItemIcon #FooterItem2Icon {
            Anchor: (Width: 16, Height: 16);
            ItemId: "Ingredient_Void_Essence";
          }

          Label #FooterItem2Text {
            Padding: (Left: 6);
            Style: (FontSize: 12, TextColor: #b4c8c9);
            Text: "Esencia del Vacio = 4min";
          }
        }

        Label #FooterLine4 {
          Style: (
            FontSize: 11,
            TextColor: #7caacc,
            HorizontalAlignment: Center,
            VerticalAlignment: Center,
          );
          Text: "Hecho con carino por Ferreira_ para Jogando Bem: jogandobem.com.br";
        }
      }
    }
  }
}

$C.@BackButton {}
